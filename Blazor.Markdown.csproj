<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <Authors>Tananut Songsiriwith, Michael McCabe</Authors>
    <Company>Nancom Ltd., 1130lab llc.</Company>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <Description>Razor Component Library for Convert Markdown text to HTML DOM</Description>
    <PackageProjectUrl>https://github.com/mccabe93/Blazor.Markdown</PackageProjectUrl>
    <PackageTags>Markdown,Blazor</PackageTags>
    <AssemblyVersion>10.0.0.0</AssemblyVersion>
    <PackageId>$(AssemblyName).net</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HtmlSanitizer" Version="9.1.891-beta" />
    <PackageReference Include="Markdig" Version="0.44.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\" />
  </ItemGroup>

  <ItemGroup>
    <None Include="LICENSE">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>
</Project>
